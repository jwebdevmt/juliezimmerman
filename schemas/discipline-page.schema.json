{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://juliezimmerman.me/schemas/discipline-page.schema.json",
  "title": "Discipline Page",
  "description": "Content schema for reusable professional discipline pages on juliezimmerman.me.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "slug",
    "status",
    "seo",
    "hero",
    "philosophy",
    "problems",
    "approach",
    "projects",
    "experience",
    "technologies",
    "related_writing",
    "contact",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "review",
        "published",
        "archived"
      ]
    },
    "nav_label": {
      "type": "string"
    },
    "seo": {
      "$ref": "#/$defs/seo"
    },
    "hero": {
      "$ref": "#/$defs/hero"
    },
    "philosophy": {
      "$ref": "#/$defs/philosophy"
    },
    "problems": {
      "$ref": "#/$defs/list_section"
    },
    "approach": {
      "$ref": "#/$defs/text_section"
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/experience"
      }
    },
    "technologies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/technology_group"
      }
    },
    "related_writing": {
      "$ref": "#/$defs/related_writing"
    },
    "business_value": {
      "anyOf": [
        {
          "$ref": "#/$defs/text_section"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact": {
      "$ref": "#/$defs/contact"
    },
    "closing_statement": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "updated": {
      "type": "string",
      "format": "date"
    }
  },
  "$defs": {
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 170
        },
        "canonical_path": {
          "type": "string"
        },
        "og_title": {
          "type": "string"
        },
        "og_description": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "hero": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eyebrow",
        "headline",
        "intro"
      ],
      "properties": {
        "eyebrow": {
          "type": "string"
        },
        "headline": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "philosophy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "anchor",
        "intro",
        "principles",
        "closing"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "closing": {
          "type": "string"
        }
      }
    },
    "list_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "items"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "text_section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "paragraphs"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "url"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "external": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary",
        "details",
        "tags"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "featured": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "organization",
        "summary"
      ],
      "properties": {
        "role": {
          "type": "string"
        },
        "organization": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "technology_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "items"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "related_writing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "intro",
        "match_tags",
        "limit"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "intro": {
          "type": "string"
        },
        "match_tags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "manual_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/link"
          }
        }
      }
    },
    "contact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "paragraphs",
        "cta"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "cta": {
          "$ref": "#/$defs/link"
        }
      }
    }
  }
}
