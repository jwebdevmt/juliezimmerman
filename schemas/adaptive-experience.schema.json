{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Canonical Adaptive Experience",
  "type": "object",
  "required": ["schema_version", "slug", "title", "summary", "published", "experience", "constraints", "perspectives", "synthesis", "publishing"],
  "properties": {
    "schema_version": {"const": 1},
    "slug": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "published": {"type": "boolean"},
    "experience": {
      "type": "object",
      "required": ["type", "destination", "audience"],
      "properties": {
        "type": {"type": "string"},
        "destination": {"type": "string"},
        "duration": {"type": "string"},
        "audience": {"type": "string"},
        "canonical_page": {"type": "string"}
      }
    },
    "constraints": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "perspectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "excerpt", "full_text"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "role": {"type": "string"},
          "excerpt": {"type": "string"},
          "full_text": {"type": "string"},
          "pin": {"type": "object"}
        }
      }
    },
    "synthesis": {
      "type": "object",
      "required": ["principle", "summary", "lessons"],
      "properties": {
        "principle": {"type": "string"},
        "summary": {"type": "string"},
        "lessons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "taxonomy": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
    "publishing": {
      "type": "object",
      "required": ["outputs"],
      "properties": {
        "outputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "pinterest_board": {"type": "string"},
        "default_image": {"type": "string"},
        "allow_future_microsite": {"type": "boolean"}
      }
    }
  }
}
